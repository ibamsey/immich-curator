[Unit]
Description=immich-curator (Next.js LAN sidecar)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ian/immich-curator
Environment=NODE_ENV=production
Environment=PATH=/home/ian/.nvm/versions/node/v20.19.5/bin:/usr/bin:/bin
ExecStart=/home/ian/immich-curator/scripts/run-production.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
