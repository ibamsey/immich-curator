# Copy to .env.local (chmod 600). Never commit secrets.

# Immich (server-side only — Route Handlers, not NEXT_PUBLIC_*)
IMMICH_SERVER_URL=http://127.0.0.1:2283

# Curator TARGET: Immich library owner; API key MUST belong to this user (ADR-0002)
IMMICH_API_KEY=

# Optional: fail startup if /users/me email does not match
# CURATOR_TARGET_EMAIL=

# Curator OPERATOR: default album-share collaborator (UC-012 / UC-009 share)
CURATOR_OPERATOR_EMAIL=
# Optional: operator API key for UC-003 comments (must belong to operator user), or set via Admin → .curator/config.local.json
# IMMICH_OPERATOR_API_KEY=
# Optional: operator Immich user UUID (skips email lookup)
# CURATOR_OPERATOR_USER_ID=

# Optional: resolve operator email → user id when target key cannot list all users
# IMMICH_ADMIN_API_KEY=

# Optional: Explore / header default album scope (UUID)
CURATOR_DEFAULT_ALBUM_ID=

# Optional: default role when sharing albums with operator (editor | viewer)
# CURATOR_DEFAULT_SHARE_ROLE=editor

# Legacy alias for CURATOR_DEFAULT_ALBUM_ID (Poundsgate deployment example)
# POUNDSGATE_ALBUM_ID=4c66a1a2-bea1-450b-83b8-a84f91fb4f76

# Optional: bind sidecar to LAN (firewall / reverse proxy for access control)
# HOST=0.0.0.0
# PORT=3000
